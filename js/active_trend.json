{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Participation Trends by Gender, 2017-2025",
    "subtitle": [
      "Annual participation rate. 2017-2023 are financial years (FY17 = Jul 2016–Jun 2017);",
      "2024-2025 are calendar years from a newer release, so the line breaks between them."
    ],
    "fontSize": 22,
    "subtitleFontSize": 17,
    "subtitlePadding": 6
  },
  "data": { "url": "data/participation_frequency_2017_2025.csv" },
  "params": [
    {
      "name": "freqSel",
      "value": "At least once per week",
      "bind": {
        "input": "radio",
        "options": ["At least once per week", "At least three times per week"],
        "name": "Participation: "
      }
    }
  ],
  "width": "container",
  "height": "container",
  "autosize": { "type": "fit", "contains": "padding", "resize": true },
  "transform": [
    { "filter": "datum.frequency === freqSel" },
    { "filter": "datum.dimension === 'Gender'" }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": { "domain": [2016.7, 2025.3], "nice": false, "zero": false },
      "axis": {
        "values": [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025],
        "labelExpr": "datum.value <= 2023 ? 'FY' + slice(toString(datum.value), 2) : toString(datum.value)",
        "labelOverlap": false,
        "labelAngle": 0,
        "grid": false
      }
    }
  },
  "layer": [
    {
      "data": { "values": [{ "x0": 2023.15, "x1": 2023.85 }] },
      "mark": { "type": "rect", "color": "#eeeeee" },
      "encoding": {
        "x": { "field": "x0", "type": "quantitative" },
        "x2": { "field": "x1" }
      }
    },
    {
      "data": { "values": [{ "x": 2023.5, "label": ["New release,", "calendar years:", "not comparable"] }] },
      "mark": { "type": "text", "fontSize": 11, "color": "#555", "baseline": "top", "lineHeight": 13 },
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "y": { "datum": 97 },
        "text": { "field": "label" }
      }
    },
    {
      "data": { "values": [{ "x": 2019.5 }] },
      "mark": { "type": "rule", "strokeDash": [4, 4], "color": "#999" },
      "encoding": { "x": { "field": "x", "type": "quantitative" } }
    },
    {
      "data": { "values": [{ "x": 2019.5, "label": "Method change (Jul 2019)" }] },
      "mark": { "type": "text", "fontSize": 11, "color": "#555", "align": "left", "dx": 4, "baseline": "bottom" },
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "y": { "datum": 5 },
        "text": { "field": "label" }
      }
    },
    {
      "mark": { "type": "line", "point": { "filled": true, "size": 75 } },
      "encoding": {
        "y": {
          "field": "rate",
          "type": "quantitative",
          "title": "Participation rate (% of adults)",
          "scale": { "domain": [0, 100], "nice": false },
          "axis": { "values": [0, 20, 40, 60, 80, 100] }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": "Gender",
          "scale": { "domain": ["Female", "Male"], "range": ["#e0529c", "#3a63d8"] }
        },
        "detail": [{ "field": "group", "type": "nominal" }, { "field": "series", "type": "nominal" }],
        "order": { "field": "year", "type": "quantitative" },
        "tooltip": [
          { "field": "group", "title": "Gender" },
          { "field": "period", "title": "Period" },
          { "field": "rate", "type": "quantitative", "title": "Participation rate (%)", "format": ".1f" },
          { "field": "reliability", "title": "Note" },
          { "field": "series", "title": "Data source" }
        ]
      }
    }
  ],
  "config": {
    "axis": { "labelFontSize": 12, "titleFontSize": 13 },
    "legend": { "labelFontSize": 12, "titleFontSize": 12, "orient": "top" }
  }
}